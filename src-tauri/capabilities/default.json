{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-ios/refs/heads/develop/nicegram-assistant/nicegram-assistant/nicegram-assistant-app/capabilities/.schema.json",
  "identifier": "default",
  "description": "Default capabilities",
  "windows": ["*"],
